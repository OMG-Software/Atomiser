# Atomiser environment configuration
# Copy this file to .env and fill in real values before running.

# 32+ byte random secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# production | development
ENV=development

# SQLite database path
DATABASE_PATH=./data/atomiser.db

# Where uploaded raw files and transcoded videos are stored
UPLOAD_DIR=./uploads

# Max single-upload size in megabytes
MAX_UPLOAD_MB=500

# WebAuthn / passkey relying-party ID. In production this must be your domain.
WEBAUTHN_RP_ID=localhost

# Set to false to serve uploaded videos as-is instead of transcoding them.
# Useful on low-resource servers. Thumbnail extraction still runs.
TRANSCODE_VIDEOS=true

# Bind address for uvicorn (development only; production uses nginx + unix socket)
HOST=127.0.0.1
PORT=8000

# Absolute base URL of the site, e.g. https://videos.example.com. Used to build
# links that leave the app (password reset and invite emails), because the Host
# header a request arrives with cannot be trusted for that. Optional otherwise.
SITE_URL=

# --- Transcoding ------------------------------------------------------------

# How many videos are transcoded at once. 1 keeps ffmpeg from starving the web
# worker; raise it only if the machine has cores to spare.
TRANSCODE_CONCURRENCY=1

# How many times a failing transcode is retried before it is marked failed.
TRANSCODE_MAX_ATTEMPTS=3

# Keep the original upload after transcoding. The original is roughly as large
# as all renditions combined and is never served, so keeping it roughly doubles
# storage per video. Leave false unless you want the pristine file back.
KEEP_RAW_UPLOADS=false

# Run the transcode worker inside the web app. Set false if you run it as a
# separate process (see docs/DEPLOYMENT.md).
RUN_TRANSCODE_WORKER=true

# --- Rate limiting ----------------------------------------------------------

# In-app throttling of the auth endpoints. This is independent of the nginx
# limit_req zones, so protection still applies behind a different proxy.
RATE_LIMIT_ENABLED=true

# Sliding window in seconds over which failures are counted.
RATE_LIMIT_WINDOW_SECONDS=900

# Failed sign-ins per email address before the account is locked for the window.
LOGIN_MAX_FAILURES_PER_EMAIL=8

# Failed sign-ins per source IP before that address is throttled.
LOGIN_MAX_FAILURES_PER_IP=25

# How long a lockout lasts, in minutes.
LOCKOUT_MINUTES=15

# --- Outbound email (optional) ----------------------------------------------

# Leave SMTP_HOST blank to run with no mail at all — the default. Invites are
# then copy-paste links and a forgotten password is reset by an admin, exactly
# as before. Set SMTP_HOST *and* SMTP_FROM to enable emailed invites and
# self-service password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Use STARTTLS on a plain connection (port 587). Set SMTP_SSL=true instead for
# implicit TLS (port 465).
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=20

# How long a password reset link stays valid, in minutes.
PASSWORD_RESET_TTL_MINUTES=60

# --- Email notifications ----------------------------------------------------

# Email members when someone posts a new site-visible video. Members are
# subscribed by default and can opt out on their profile or from the
# unsubscribe link in any notification. Setting this to false suppresses the
# whole feature regardless of individual preferences.
#
# Requires SMTP above AND SITE_URL, since the sending worker has no request to
# derive link hostnames from.
NOTIFY_NEW_VIDEOS=true

# Run the email queue worker inside the web app. Set false to run it as a
# separate process (see docs/DEPLOYMENT.md).
RUN_EMAIL_WORKER=true

# Messages sent per pass over a single SMTP connection. Bounds how fast a
# fan-out to a large membership hits your provider's rate limit.
EMAIL_BATCH_SIZE=20

# Seconds between passes when the queue is empty.
EMAIL_POLL_SECONDS=10

# Delivery attempts before a message is abandoned. Retries back off
# exponentially from EMAIL_RETRY_MINUTES.
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_MINUTES=5

# Days a delivered or abandoned message is kept for the admin view.
EMAIL_RETENTION_DAYS=30
